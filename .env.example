# Только серверные переменные. Не добавляйте префикс NEXT_PUBLIC_.
BITRIX24_WEBHOOK_URL=
BITRIX24_ASSIGNED_BY_ID=
BITRIX24_SOURCE_ID=WEB
BITRIX24_TIMEOUT_MS=10000
# Полный публичный origin без завершающего слеша, например https://your-domain.ru
SITE_ORIGIN=http://127.0.0.1:3000
# Включать только за доверенным прокси, который перезаписывает X-Forwarded-For.
TRUST_PROXY=false
# Реквизиты реального оператора. Без них приём заявок не включается.
DATA_OPERATOR_NAME=
DATA_OPERATOR_ADDRESS=
DATA_OPERATOR_EMAIL=
